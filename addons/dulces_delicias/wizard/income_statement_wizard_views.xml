<?xml version="1.0" encoding="utf-8"?>
<!--
    A VIEW describes how a model is displayed (form, list, kanban, pivot...).
    An ACTION (ir.actions.act_window) opens a model with some views; menus
    point to actions. target="new" opens it as a pop-up (a wizard).
-->
<odoo>
    <record id="view_income_statement_wizard_form" model="ir.ui.view">
        <field name="name">dd.income.statement.wizard.form</field>
        <field name="model">dd.income.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Estado de Resultados">
                <p class="text-muted">
                    Ingresos menos costos y gastos del periodo elegido, calculados a
                    partir de los asientos contables publicados.
                </p>
                <group>
                    <group>
                        <field name="period" widget="radio"/>
                    </group>
                    <group>
                        <field name="date_from" readonly="period != 'custom'" force_save="1"/>
                        <field name="date_to" readonly="period != 'custom'" force_save="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view" string="Ver en pantalla" type="object" class="btn-primary"/>
                    <button name="action_print_pdf" string="Descargar PDF" type="object" class="btn-secondary"/>
                    <button name="action_open_journal_items" string="Ver apuntes contables" type="object" class="btn-secondary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_income_statement_wizard" model="ir.actions.act_window">
        <field name="name">Estado de Resultados</field>
        <field name="res_model">dd.income.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
