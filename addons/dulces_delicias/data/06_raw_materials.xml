<?xml version="1.0" encoding="utf-8"?>
<!--
    Raw materials. UI: Inventory > Products > Products (filter: Materias Primas)

    Key product fields:
      is_storable     True = Odoo tracks the quantity on hand
      uom_id          unit used to COUNT the stock (kg, L, Units)
      uom_po_id       unit used to BUY it (e.g. 50 kg sacks, dozens of eggs)
      standard_price  current cost per stock unit
      route_ids       how to replenish it: "Buy" = with a purchase order
      seller_ids      vendor, price (per purchase unit) and lead time in days

    Reordering rules (min / max): when the FORECAST quantity drops below the
    minimum, Odoo proposes to buy enough to get back to the maximum.
    UI: Inventory > Operations > Procurement > Replenishment
    qty_multiple rounds the proposal (e.g. multiples of 50 kg = whole sacks).
-->
<odoo>
    <!-- ===================== CARAMELOS ===================== -->
    <record id="raw_sugar" model="product.product">
        <field name="name">Azúcar</field>
        <field name="default_code">MP-001</field>
        <field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="categ_id" ref="categ_raw_materials"/>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="uom_po_id" ref="uom_sack_50kg"/>
        <field name="standard_price">1.00</field>
        <field name="sale_ok" eval="False"/>
        <field name="route_ids" eval="[Command.link(ref('purchase_stock.route_warehouse0_buy'))]"/>
        <field name="seller_ids" eval="[Command.create({'partner_id': ref('vendor_insumos'), 'price': 50.00, 'delay': 2})]"/>
        <field name="description_purchase">Azúcar refinada, saco de 50 kg.</field>
    </record>

